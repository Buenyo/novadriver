<?xml version="1.0" encoding="utf-8"?>
<!-- Só HTTPS. O Android 7.0 (API 24) não tem a raiz ISRG Root X1 (Let's Encrypt),
     usada pelo Open-Meteo; ela é embutida aqui junto com as raízes do sistema.
     SHA-256: 96:BC:EC:06:26:49:76:F3:74:60:77:9A:CF:28:C5:A7:CF:E8:A3:C0:AA:E1:1A:8F:FC:EE:05:C0:BD:DF:08:C6 -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="@raw/isrg_root_x1" />
        </trust-anchors>
    </base-config>
</network-security-config>
